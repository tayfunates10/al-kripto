# Güvenli varsayılan: gerçek emir göndermez.
AL_KRIPTO_ENV=development
AL_KRIPTO_TRADING_MODE=paper
AL_KRIPTO_EXCHANGE=binance
AL_KRIPTO_SYMBOLS=BTCUSDT,ETHUSDT

# Gizli değerleri bu dosyaya yazmayın. Yerel .env veya secret yöneticisi kullanın.
AL_KRIPTO_API_KEY=
AL_KRIPTO_API_SECRET=

# Canlı mod varsayılan olarak kilitlidir.
AL_KRIPTO_ENABLE_LIVE=false
AL_KRIPTO_LIVE_ACK=
